<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="0dp" android:layout_height="?attr/actionBarSize" android:background="?attr/colorSurface" app:title="@string/restricted_apps_title" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/lockedBanner" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/content_horizontal_padding" android:layout_marginEnd="@dimen/content_horizontal_padding" android:layout_marginTop="@dimen/spacing_sm" android:background="@drawable/bg_status_active" android:padding="@dimen/spacing_sm" android:text="@string/rules_locked_read_only" android:textAppearance="?attr/textAppearanceBodySmall" android:visibility="gone" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/toolbar" />
    <TextView android:id="@+id/emptyState" android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:padding="@dimen/spacing_lg" android:text="@string/apps_empty_state" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" app:layout_constraintBottom_toTopOf="@id/editorComposer" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/lockedBanner" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/appPackageRecyclerView" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingStart="@dimen/content_horizontal_padding" android:paddingEnd="@dimen/content_horizontal_padding" android:paddingTop="@dimen/spacing_sm" android:paddingBottom="@dimen/spacing_sm" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" app:layout_constraintBottom_toTopOf="@id/editorComposer" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/lockedBanner" />
    <!-- Docked, but only a header tall until the user asks for it. Expanded it is most of a
         phone screen, which is why it used to leave room for a single rule. -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/editorComposer" style="@style/Widget.ModernHabit.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="@dimen/content_horizontal_padding" app:cardBackgroundColor="?attr/colorPrimaryContainer" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/spacing_md" android:paddingEnd="@dimen/spacing_md" android:paddingTop="@dimen/spacing_sm" android:paddingBottom="@dimen/spacing_sm">
            <LinearLayout android:id="@+id/composerHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="@dimen/touch_target_min" android:orientation="horizontal">
                <TextView android:id="@+id/composerTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/composer_add_app_rule" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnPrimaryContainer" />
                <ImageView android:id="@+id/composerChevron" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:rotation="90" android:src="@drawable/ic_chevron_right" app:tint="?attr/colorOnPrimaryContainer" />
            </LinearLayout>
            <LinearLayout android:id="@+id/composerBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="@dimen/spacing_sm" android:visibility="gone">
                <com.google.android.material.button.MaterialButton android:id="@+id/chooseInstalledAppButton" style="@style/Widget.ModernHabit.Button.Pill" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/choose_installed_app" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/packageNameInput" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:hint="@string/restricted_app_package_hint" app:helperText="@string/package_name_advanced_helper">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/packageNameEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text|textNoSuggestions" android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/newStrictRuleCheckbox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/strict_rule_checkbox" app:buttonTint="?attr/colorError" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/addButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_package_name" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/strict_rule_helper" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnPrimaryContainer" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
