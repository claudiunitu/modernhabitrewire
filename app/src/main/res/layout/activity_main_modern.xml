<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ModernMainActivity"
    tools:ignore="TooDeepLayout,TooManyViews">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:elevation="0dp"
        app:title="@string/nav_today"
        app:titleTextAppearance="?attr/textAppearanceHeadlineSmall"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/mainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/todayScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/spacing_xl">

            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/content_horizontal_padding"
                    android:paddingEnd="@dimen/content_horizontal_padding"
                    android:paddingTop="@dimen/spacing_sm"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/content_max_width">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/statusHeroCard"
                        style="@style/Widget.ModernHabit.Card.Hero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="?attr/colorPrimaryContainer">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/hero_padding">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                                <TextView android:id="@+id/protectionStatusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status_attention" android:text="@string/protection_off_badge" android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="@color/status_warning" />
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:orientation="vertical">
                                    <TextView android:id="@+id/protectionStatusTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/protection_needs_attention" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnPrimaryContainer" />
                                    <TextView android:id="@+id/protectionStatusDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:maxLines="2" android:text="@string/protection_status_inactive_detail" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnPrimaryContainer" />
                                </LinearLayout>
                            </LinearLayout>
                            <FrameLayout android:layout_width="148dp" android:layout_height="148dp" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/spacing_md">
                                <com.example.voward.AllowanceRingView android:id="@+id/allowanceRing" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/allowance_available" />
                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="20dp">
                                    <TextView android:id="@+id/remainingBudgetValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:textColor="?attr/colorOnPrimaryContainer" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="@string/remaining_today" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnPrimaryContainer" />
                                </LinearLayout>
                            </FrameLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:orientation="horizontal">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/nextPauseValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnPrimaryContainer" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/next_pause" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnPrimaryContainer" /></LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/protectedCountValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnPrimaryContainer" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rules_protected" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnPrimaryContainer" /></LinearLayout>
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton android:id="@+id/heroActionButton" style="@style/Widget.ModernHabit.Button.HeroAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:text="@string/activate_protection" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/setupReadinessCard"
                        style="@style/Widget.ModernHabit.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/section_gap"
                        app:cardBackgroundColor="?attr/colorSecondaryContainer">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_lg">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/finish_setup_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnSecondaryContainer" />
                            <TextView android:id="@+id/setupReadinessSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:text="@string/finish_setup_body" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSecondaryContainer" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/resumeSetupButton" style="@style/Widget.ModernHabit.Button.Pill" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:text="@string/continue_setup" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/today_reflection" android:textAppearance="?attr/textAppearanceTitleLarge" />

                    <com.google.android.material.card.MaterialCardView style="@style/Widget.ModernHabit.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" app:cardBackgroundColor="?attr/colorSurfaceVariant">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_lg">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/daily_intention" android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?attr/colorPrimary" />
                            <TextView android:id="@+id/todayGoalText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:text="@string/no_goal_yet" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/editIntentionButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/edit_intention" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:orientation="horizontal">
                                <TextView android:id="@+id/sessionsMetric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textAppearance="?attr/textAppearanceTitleMedium" />
                                <TextView android:id="@+id/earlyMetric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textAppearance="?attr/textAppearanceTitleMedium" />
                                <TextView android:id="@+id/limitsMetric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textAppearance="?attr/textAppearanceTitleMedium" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/rulesScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/spacing_xl"
            android:visibility="gone">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/content_horizontal_padding" android:paddingEnd="@dimen/content_horizontal_padding" android:paddingTop="@dimen/spacing_sm" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintWidth_max="@dimen/content_max_width">
                    <TextView android:id="@+id/rulesLockBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_info_banner" android:padding="@dimen/spacing_md" android:text="@string/rules_locked_read_only" android:textAppearance="?attr/textAppearanceBodyMedium" android:visibility="gone" />
                    <com.google.android.material.card.MaterialCardView android:id="@+id/rulesAppsCard" style="@style/Widget.ModernHabit.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="?attr/colorPrimaryContainer">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="92dp" android:orientation="horizontal" android:padding="@dimen/spacing_md">
                            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" android:src="@drawable/ic_rules" app:tint="?attr/colorOnPrimaryContainer" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_md" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/restricted_apps_title" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnPrimaryContainer" />
                                <TextView android:id="@+id/appsRulesSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:text="@string/no_apps_protected" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnPrimaryContainer" />
                            </LinearLayout>
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="@dimen/spacing_sm" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:id="@+id/rulesWebsitesCard" style="@style/Widget.ModernHabit.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="?attr/colorSecondaryContainer">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="92dp" android:orientation="horizontal" android:padding="@dimen/spacing_md">
                            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" android:src="@drawable/ic_web" app:tint="?attr/colorOnSecondaryContainer" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_md" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/restricted_urls_title" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSecondaryContainer" />
                                <TextView android:id="@+id/urlRulesSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:text="@string/no_sites_protected" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSecondaryContainer" />
                            </LinearLayout>
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="@dimen/spacing_sm" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:padding="@dimen/spacing_md" android:text="@string/rules_privacy_note" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/progressScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/spacing_xl"
            android:visibility="gone">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/content_horizontal_padding" android:paddingEnd="@dimen/content_horizontal_padding" android:paddingTop="@dimen/spacing_sm" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintWidth_max="@dimen/content_max_width">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/progress_intro" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurfaceVariant" />
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.ModernHabit.Card.Hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" app:cardBackgroundColor="?attr/colorPrimaryContainer">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/hero_padding">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/progressWeekUsage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:textColor="?attr/colorOnPrimaryContainer" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/weekly_usage_label" android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?attr/colorOnPrimaryContainer" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
                                <TextView android:id="@+id/progressWeekSessions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnPrimaryContainer" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/week_sessions" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnPrimaryContainer" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.ModernHabit.Card.Compact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" app:cardBackgroundColor="?attr/colorSecondaryContainer">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/spacing_md" android:paddingEnd="@dimen/spacing_md" android:paddingTop="@dimen/spacing_sm" android:paddingBottom="@dimen/spacing_sm">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/today_usage" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSecondaryContainer" />
                            <TextView android:id="@+id/progressTodayUsage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSecondaryContainer" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/last_seven_days" android:textAppearance="?attr/textAppearanceTitleLarge" />
                    <com.google.android.material.card.MaterialCardView android:id="@+id/progressEmptyState" style="@style/Widget.ModernHabit.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" app:cardBackgroundColor="?attr/colorSurfaceVariant">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="@dimen/spacing_lg">
                            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" android:src="@drawable/ic_progress" app:tint="?attr/colorPrimary" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:gravity="center" android:text="@string/progress_empty_title" android:textAppearance="?attr/textAppearanceTitleMedium" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:gravity="center" android:text="@string/progress_empty_body" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:id="@+id/progressDataCard" style="@style/Widget.ModernHabit.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:visibility="gone" app:cardBackgroundColor="?attr/colorSurfaceVariant">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_lg">
                            <com.example.voward.WeeklyUsageChartView android:id="@+id/weeklyUsageChart" android:layout_width="match_parent" android:layout_height="144dp" android:contentDescription="@string/restricted_use_chart_description" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:orientation="horizontal"><TextView android:id="@+id/progressEarlyMetric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textAppearance="?attr/textAppearanceTitleMedium" /><TextView android:id="@+id/progressLimitsMetric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textAppearance="?attr/textAppearanceTitleMedium" /></LinearLayout>
                            <TextView android:id="@+id/progressCommonTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:gravity="center" android:text="@string/no_time_pattern" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                            <TextView android:id="@+id/progressAlternativeChoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:gravity="center" android:text="@string/no_alternative_pattern" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/settingsScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/spacing_xl"
            android:visibility="gone">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/content_horizontal_padding" android:paddingEnd="@dimen/content_horizontal_padding" android:paddingTop="@dimen/spacing_sm" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintWidth_max="@dimen/content_max_width">

                    <com.google.android.material.card.MaterialCardView android:id="@+id/settingsLockedCard" style="@style/Widget.ModernHabit.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="?attr/colorTertiaryContainer">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_lg">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_locked_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnTertiaryContainer" />
                            <TextView android:id="@+id/settingsLockedSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:text="@string/settings_locked_body" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnTertiaryContainer" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout android:id="@+id/editableSettingsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView style="@style/Widget.ModernHabit.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="?attr/colorSurfaceVariant">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_lg">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_md" android:text="@string/settings_intention_section" android:textAppearance="?attr/textAppearanceTitleLarge" />
                            <com.google.android.material.textfield.TextInputLayout android:id="@+id/functionalGoalInputLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/functional_goal_short" app:helperText="@string/functional_goal_helper">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/functionalGoalInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLength="200" android:maxLines="3" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:text="@string/replacement_suggestions_setting" android:textAppearance="?attr/textAppearanceTitleMedium" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:text="@string/replacement_suggestions_helper" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:hint="@string/replacement_one"><com.google.android.material.textfield.TextInputEditText android:id="@+id/replacementOneInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLength="60" android:maxLines="1" /></com.google.android.material.textfield.TextInputLayout>
