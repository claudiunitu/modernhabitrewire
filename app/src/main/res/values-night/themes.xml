<resources>
    <!-- Dark theme overrides — Material 3 DayNight picks this automatically at night. -->
    <style name="Theme.Voward" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_dark_primary</item>
        <item name="colorOnPrimary">@color/md_dark_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_dark_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_dark_on_primary_container</item>
        <item name="colorSecondary">@color/md_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_dark_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_dark_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_dark_on_secondary_container</item>
        <item name="colorTertiary">@color/md_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_dark_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_dark_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_dark_on_tertiary_container</item>
        <item name="colorError">@color/md_dark_error</item>
        <item name="colorOnError">@color/md_dark_on_error</item>
        <item name="colorErrorContainer">@color/md_dark_error_container</item>
        <item name="colorOnErrorContainer">@color/md_dark_on_error_container</item>
        <item name="android:colorBackground">@color/md_dark_background</item>
        <item name="android:windowBackground">@color/md_dark_background</item>
        <item name="colorOnBackground">@color/md_dark_on_background</item>
        <item name="colorSurface">@color/md_dark_surface</item>
        <item name="colorOnSurface">@color/md_dark_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_dark_on_surface_variant</item>
        <item name="colorSurfaceDim">@color/md_dark_surface_dim</item>
        <item name="colorSurfaceBright">@color/md_dark_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/md_dark_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_dark_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_dark_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_dark_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_dark_surface_container_highest</item>
        <item name="colorOutline">@color/md_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_dark_outline_variant</item>
        <item name="colorSurfaceInverse">@color/md_dark_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_dark_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_dark_inverse_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Voward.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Voward.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Voward.Large</item>
        <item name="materialCardViewStyle">@style/Widget.Voward.Card</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- A subtle edge keeps adjacent dark surfaces legible without heavy elevation. -->
    <style name="Widget.Voward.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/md_dark_outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
