<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Re-runs the policy reconcile at boot so a half-applied state heals immediately. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Measures how long an approved session was really spent in the app instead of charging
         wall time. Granted by the user in Settings, not from a computer; sessions fall back to
         the quoted duration without it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Ends an approved session on time whether or not Voward is still running. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Grayscale mode: must be granted once via ADB:
         adb shell pm grant com.example.voward android.permission.WRITE_SECURE_SETTINGS -->
    <!-- Optional developer/device-owner feature; normal installs run without grayscale. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility: launchable apps, browsers, and the safety-critical components. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <!-- Safety-critical components SafetyPolicy resolves instead of guessing by name. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL_EMERGENCY" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.content.pm.action.REQUEST_PERMISSIONS" />
        </intent>
        <!-- Section 4.3: browsers are resolved, not listed. The hard-coded package list this
             replaces could not see a browser released after it was written. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Voward"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="35">
        
        <activity
            android:name="com.example.voward.ModernMainActivity"
            android:exported="true"
            android:theme="@style/Theme.Voward.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.voward.UrlListEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.Voward.NoActionBar"
            android:parentActivityName="com.example.voward.ModernMainActivity"/>

        <activity
            android:name="com.example.voward.AppPackagesListEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.Voward.NoActionBar"
            android:parentActivityName="com.example.voward.ModernMainActivity" />

        <activity
            android:name="com.example.voward.HelpActivity"
            android:exported="false"
            android:theme="@style/Theme.Voward.NoActionBar"
            android:parentActivityName="com.example.voward.ModernMainActivity" />

        <activity
            android:name="com.example.voward.SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Voward.NoActionBar"
            android:parentActivityName="com.example.voward.ModernMainActivity" />

        <activity
            android:name="com.example.voward.InstalledAppPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Voward.NoActionBar"
            android:parentActivityName="com.example.voward.AppPackagesListEditorActivity" />
            
        <!-- Escape ladder rung 2. Exported so it can be started with
             adb shell am start -n com.example.voward/.ReleaseActivity when the main screen
             will not open. Opening it reveals nothing: it still demands the recovery key,
             the cooldown, and the confirmation window. Its own task affinity and a platform
             theme keep it independent of the rest of the app's UI. -->
        <!-- Where the system's "paused by your admin" dialog sends the user. Without this
             a suspended app has no route back to the decision gate. -->
        <activity
            android:name="com.example.voward.SuspendedAppDetailsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SHOW_SUSPENDED_APP_DETAILS" />
                <!-- The platform sends this implicitly, package-targeted, so without DEFAULT
                     the filter cannot resolve and the button leads nowhere. -->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.voward.ReleaseActivity"
            android:exported="true"
            android:label="@string/release_title"
            android:taskAffinity=".release"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.DarkActionBar" />

        <activity
            android:name="com.example.voward.DecisionGateActivity"
            android:exported="false"
            android:taskAffinity=".firewall"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Voward.NoActionBar" />

        <service
            android:name="com.example.voward.PolicyReconcileJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name="com.example.voward.SessionDeadlineReceiver"
            android:exported="false" />

        <!-- The only package event the platform still delivers to a manifest receiver. There
             is no PACKAGE_ADDED equivalent; the short reconcile poll covers that direction. -->
        <receiver
            android:name="com.example.voward.PackageRemovedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.example.voward.BootCompletedReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name="com.example.voward.BrowserCheckActivity"
            android:exported="false"
            android:label="@string/browser_check_title"
            android:theme="@android:style/Theme.DeviceDefault.Light.DarkActionBar" />

        <receiver
            android:name="com.example.voward.MyDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
