<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds are marked test-only so `adb shell dpm set-device-owner` is accepted on a phone
  that has already finished setup. A production build has to be provisioned during setup, and
  must not carry this flag: a test-only device owner can be torn down with
  `adb shell dpm remove-active-admin`, which would be a bypass rather than a convenience.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:testOnly="true" />
</manifest>
